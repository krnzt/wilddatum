{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ecoscope.dev/schemas/provider-manifest-v1.schema.json",
  "title": "EcoScope provider manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "provider_id",
    "name",
    "version",
    "status",
    "capabilities",
    "allowed_network_origins",
    "authentication",
    "standards"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "provider_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "name": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "status": {
      "enum": ["built_in", "community", "provider_reviewed", "provider_maintained"]
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "catalog_search",
          "resource_resolve",
          "asset_plan",
          "asset_fetch",
          "observations_query",
          "samples_query",
          "spatial_search",
          "stream_subscribe",
          "citation_resolve",
          "policy_evaluate"
        ]
      }
    },
    "allowed_network_origins": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^https://[^/]+$"}
    },
    "authentication": {"type": "array", "items": {"type": "string"}},
    "standards": {"type": "array", "items": {"type": "string"}},
    "homepage": {"type": ["string", "null"], "format": "uri"},
    "support_url": {"type": ["string", "null"], "format": "uri"}
  }
}
