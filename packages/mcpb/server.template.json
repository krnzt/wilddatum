{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.krnzt/wilddatum",
  "title": "WildDatum",
  "description": "Agent-native ecological data discovery, analysis, visualization, and provenance",
  "repository": {
    "url": "https://github.com/krnzt/wilddatum",
    "source": "github"
  },
  "version": "${VERSION}",
  "packages": [
    {
      "registryType": "mcpb",
      "identifier": "${MACOS_MCPB_URL}",
      "fileSha256": "${MACOS_MCPB_SHA256}",
      "transport": {
        "type": "stdio"
      }
    },
    {
      "registryType": "mcpb",
      "identifier": "${LINUX_MCPB_URL}",
      "fileSha256": "${LINUX_MCPB_SHA256}",
      "transport": {
        "type": "stdio"
      }
    }
  ]
}
