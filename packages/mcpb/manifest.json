{
  "manifest_version": "0.3",
  "name": "ecoscope",
  "display_name": "EcoScope",
  "version": "0.1.0",
  "description": "Discover, materialize, visualize, select, and cite ecological data",
  "long_description": "A local-first ecological data workbench for agents. NEON and user-selected local scientific files share reproducible manifests, semantic multimodal views, structured selections, and provenance-aware exports.",
  "author": {
    "name": "EcoScope contributors"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/krnzt/ecoscope.git"
  },
  "homepage": "https://github.com/krnzt/ecoscope",
  "documentation": "https://github.com/krnzt/ecoscope#readme",
  "support": "https://github.com/krnzt/ecoscope/issues",
  "server": {
    "type": "binary",
    "entry_point": "server/ecoscope",
    "mcp_config": {
      "command": "${__dirname}/server/ecoscope",
      "args": ["mcp"],
      "env": {}
    }
  },
  "tools_generated": true,
  "keywords": ["ecology", "NEON", "hyperspectral", "lidar", "geospatial", "visualization", "science"],
  "license": "MIT",
  "privacy_policies": ["https://www.neonscience.org/privacy-policy"],
  "compatibility": {
    "platforms": ["darwin", "win32", "linux"]
  }
}
